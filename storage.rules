rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chat_uploads/{chatId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /group_uploads/{groupId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
